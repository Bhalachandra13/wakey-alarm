<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android API 26+).

  Combines the brand background colour with the foreground
  drawable (the full Wakey-Wakey artwork) so the launcher can
  mask the result into a circle, squircle, teardrop, etc. The
  foreground is intentionally full-bleed: the mask crops the
  outer ~25%, so the visible art is the centred 66×66dp region
  of the 108×108dp source.

  See https://developer.android.com/develop/ui/views/launch/icon_design_adaptive
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
